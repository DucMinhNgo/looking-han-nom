# Secrets — NEVER commit real keys. Only .env.example is tracked.
.env
*.key

# Runtime state — lives in the mounted data/ volume, not in git/the image.
data/
!data/.gitkeep

# Virtualenvs and local tooling
.venv*/
.tools/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
coverage.xml
.mypy_cache/
.ruff_cache/
