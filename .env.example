# Tra cứu Hán-Nôm — environment template.
#
# The quick way is not to edit this file at all:
#
#     python -m app.cli --init-env
#
# That generates a .env with a random AUTH_SECRET and a hash of a password you
# choose, ready to run. Copy this file to `.env` and fill it in by hand only if
# you would rather do it yourself.
#
# `.env` is gitignored. NEVER commit real secrets.

# =====================================================================
# Auth — this app is internet-facing on its own domain, so this login IS
# the security boundary. Images sit behind it too.
# =====================================================================

# Signs session cookies. The app REFUSES TO START if this is empty.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# The super admin. It lives here rather than in data/users.json so a mistake
# in the user file can never lock everyone out.
APP_USERNAME=admin

# bcrypt hash, not the password itself.
#   python -m app.cli --hash-password
APP_PASSWORD_HASH=

# 1 when served over HTTPS (the normal case behind a reverse proxy).
# Set 0 for plain HTTP, including http://localhost — a Secure cookie is never
# sent over http, so leaving this at 1 makes login appear to succeed and then
# bounce you straight back to the login page.
COOKIE_SECURE=0

# =====================================================================
# Data — where the dataset and the pictures live
#
# Running without Docker: point these at real paths, e.g.
#   DATASET_PATH=sample/dataset.jsonl
#   IMAGES_DIR=sample/images
#
# Running with Docker: docker-compose.yml pins its own paths inside the
# container, so whatever is set here is ignored and the bind mounts decide.
# =====================================================================

# The JSONL, one row per image:
#   {"image": "...", "post_id": "https://facebook.com/...",
#    "caption": "...", "ground_truth": "..."}
DATASET_PATH=/data/dataset.jsonl

# The picture folder. Sub-folders are scanned too; a row may name a file with
# or without its path, in any case, and with a different image extension —
# the four matching steps are documented in app/core/localimages.py.
IMAGES_DIR=/data/images

DATA_DIR=/data

# Results per page.
PAGE_SIZE=24
